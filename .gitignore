# ─────────────────────────────────────────────────────────────
node_modules/
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Frontend build outputs
frontend/dist/
frontend/build/
dist/
build/
.vite/
*.local

# Dependency directories
jspm_packages/
bower_components/

# Yarn / pnpm
.yarn/
.yarnrc.yml
.pnp.*
.yarn-integrity

# ─────────────────────────────────────────────────────────────
# 🔐 Environment Variables & Secrets
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example

# Secrets / keys
*.pem
*.key
secrets/
credentials.json
service-account.json

# ─────────────────────────────────────────────────────────────
# 🗄️ Database (SQLite + others)
# ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/app.db
database/*.db

# ─────────────────────────────────────────────────────────────
# 📁 Logs
# ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
!backend/logs/.gitkeep

# ─────────────────────────────────────────────────────────────
# 💻 IDE / Editor
# ─────────────────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.vim/

# Atom
.atom/

# Eclipse
.settings/
.project
.classpath

