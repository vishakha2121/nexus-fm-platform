docker-compose.override.yml

# ─────────────────────────────────────────────────────────────
# 🤖 ML / Model Files (Large binaries)
# ─────────────────────────────────────────────────────────────
*.h5
*.keras
*.pb
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
checkpoints/
models/weights/
saved_models/
outputs/
runs/
wandb/
mlruns/
lightning_logs/

# Hugging Face cache
.cache/huggingface/
huggingface/

# ─────────────────────────────────────────────────────────────
# 📊 Data Files (Large)
# ─────────────────────────────────────────────────────────────
*.csv
*.parquet
*.arrow
*.feather
*.pkl
*.pickle
data/raw/
data/processed/
datasets/

# ─────────────────────────────────────────────────────────────
# 🧪 Testing & Coverage
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# ─────────────────────────────────────────────────────────────
# 📦 Package Manager / Lock Misc
# ─────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.temp/
.tmp/
temp/
tmp/

# ─────────────────────────────────────────────────────────────
# 🔧 Miscellaneous
# ─────────────────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej
*.old
*.swp
*.swo

# Celery
celerybeat-schedule
celerybeat.pid

# Redis dump
dump.rdb

