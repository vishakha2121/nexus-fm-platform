# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 🐍 Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
backend/venv/
backend/.venv/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
nosetests.xml

# Jupyter Notebook
.ipynb_checkpoints
profile_default/
ipython_config.py

# ─────────────────────────────────────────────────────────────
# 🟢 Node.js / React / Frontend
# ─────────────────────────────────────────────────────────────
node_modules/
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Frontend build outputs
frontend/dist/
frontend/build/
dist/
build/
.vite/
*.local

# Dependency directories
jspm_packages/
bower_components/

# Yarn / pnpm
.yarn/
.yarnrc.yml
.pnp.*
.yarn-integrity

# ─────────────────────────────────────────────────────────────
# 🔐 Environment Variables & Secrets
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example

# Secrets / keys
*.pem
*.key
secrets/
credentials.json
service-account.json

# ─────────────────────────────────────────────────────────────
# 🗄️ Database (SQLite + others)
# ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/app.db
database/*.db

# ─────────────────────────────────────────────────────────────
# 📁 Logs
# ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
!backend/logs/.gitkeep

# ─────────────────────────────────────────────────────────────
# 💻 IDE / Editor
# ─────────────────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.vim/

# Atom
.atom/

# Eclipse
.settings/
.project
.classpath

# ─────────────────────────────────────────────────────────────
# 🖥️ OS Generated Files
# ─────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ─────────────────────────────────────────────────────────────
# 🐳 Docker
# ─────────────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ─────────────────────────────────────────────────────────────
# 🤖 ML / Model Files (Large binaries)
# ─────────────────────────────────────────────────────────────
*.h5
*.keras
*.pb
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
checkpoints/
models/weights/
saved_models/
outputs/
runs/
wandb/
mlruns/
lightning_logs/

# Hugging Face cache
.cache/huggingface/
huggingface/

# ─────────────────────────────────────────────────────────────
# 📊 Data Files (Large)
# ─────────────────────────────────────────────────────────────
*.csv
*.parquet
*.arrow
*.feather
*.pkl
*.pickle
data/raw/
data/processed/
datasets/

# ─────────────────────────────────────────────────────────────
# 🧪 Testing & Coverage
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.cover
.hypothesis/

# ─────────────────────────────────────────────────────────────
# 📦 Package Manager / Lock Misc
# ─────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.temp/
.tmp/
temp/
tmp/

# ─────────────────────────────────────────────────────────────
# 🔧 Miscellaneous
# ─────────────────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej
*.old
*.swp
*.swo

# Celery
celerybeat-schedule
celerybeat.pid

# Redis dump
dump.rdb

# ─────────────────────────────────────────────────────────────
# ✅ KEEP THESE FILES (Force include even if matched above)
# ─────────────────────────────────────────────────────────────
!.gitignore
!.gitkeep
!README.md
!LICENSE
!.env.example
!requirements.txt
!package.json
!package-lock.json
