# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.vim/

# Atom
.atom/

# Eclipse
.settings/
.project
.classpath

